# Default personal mode: each viewer connects their own Google account.
DASHBOARD_MODE=personal
# Public Google OAuth WEB client ID used only in personal mode.
GOOGLE_CLIENT_ID=replace-with-your-client-id.apps.googleusercontent.com
# The Figures folder and its descendants are the only accessible API subtree.
GOOGLE_DRIVE_ROOT_ID=1qXAMcNrZuqk4wlGbqZlmHydQ-cSthbIV

# Shared mode: see SHARED-SETUP.md. These are SERVER-ONLY settings.
# DASHBOARD_MODE=shared
# DASHBOARD_PASSWORD=<generate a strong password, at least 16 characters>
# GOOGLE_SERVICE_ACCOUNT_JSON=<the complete downloaded service-account JSON>
# BLOB_READ_WRITE_TOKEN=<automatically supplied by your private Vercel Blob store>
