{
  "name": "entropy-results-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "A private Google Drive research dashboard for Vercel, with the original Apps Script target retained.",
  "scripts": {
    "build": "node scripts/build.cjs",
    "dev": "node scripts/dev.cjs",
    "check": "node scripts/check.cjs",
    "test": "node --test tests/*.test.cjs",
    "clasp": "node scripts/clasp.cjs",
    "deploy": "node scripts/deploy.cjs",
